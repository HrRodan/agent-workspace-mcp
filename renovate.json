{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-8 * * *"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "schedule": [
      "* 0-8 * * 1"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "groupName": "python-deps",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "python-version"
      ],
      "groupName": "python-core"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "groupName": "python-core"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "docker-images",
      "matchPackageNames": [
        "!python"
      ]
    }
  ]
}
